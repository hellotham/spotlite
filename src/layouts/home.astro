---
import Layout from '../layouts/layout.astro'
import { Image } from 'astro:assets'
import Avatar from '../assets/me/avatar.jpg'
import { getCollection } from 'astro:content'
import ImageCards from '../components/imagecards.astro'
import ArticleList from '../components/articlelist.astro'
import CTAForm from '../components/ctaform.astro'
import Timeline from '../components/timeline.astro'
import Work from '../components/work.astro'
import Education from '../components/education.astro'
import Superpowers from '../components/superpowers.astro'
import TemplateCTA from '../components/templatecta.astro'
import cv from '../cv.json' with { type: 'json' }

const { frontmatter } = Astro.props

let social = await getCollection('social')
social = social.sort((a, b) => a.data.order - b.data.order)
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  image={frontmatter.image}
  home={true}
>
  <div class='sm:px-8'>
    <div class='mx-auto max-w-7xl lg:px-8'>
      <div class='px-4 relative lg:px-12 sm:px-8'>
        <div class='mx-auto max-w-2xl lg:max-w-5xl'>
          <div class='mt-16 animate-fade-in-up'>
            <div class='mx-auto max-w-2xl lg:max-w-4xl'>
              <div class='flex gap-6 items-center'>
                <a
                  href={`${import.meta.env.BASE_URL}`}
                  aria-label='Home'
                  class='shrink-0 h-20 w-20 block pointer-events-auto sm:h-32 sm:w-32'
                >
                  <Image
                    src={Avatar}
                    alt='Avatar'
                    width={256}
                    height={256}
                    loading='eager'
                    class='rounded-full bg-sugarSwizzle h-20 w-20 ring-1 ring-opalGray/20 shadow-md object-cover dark:bg-blackBeauty sm:h-32 sm:w-32 dark:ring-opalGray/20'
                  />
                </a>
                {
                  /* min-w-0 and break-words are both required. A flex item defaults to
                  min-width:auto, so the h1 refused to shrink below its longest word and
                  pushed past the container; with min-w-0 alone the word then overflows
                  the h1's own box instead. At 320px the tagline was clipped mid-word by
                  html{overflow-x:hidden}, with no scrollbar to reveal it. */
                }
                <h1
                  class='text-3xl text-accent tracking-tight font-serif min-w-0 break-words font-italic sm:text-4xl'
                >
                  {frontmatter.description}
                </h1>
              </div>
              <div
                class='text-base text-graniteGray mx-auto mt-6 max-w-2xl space-y-7 prose dark:text-opalGray lg:max-w-4xl dark:prose-invert'
              >
                <slot />

                {
                  /* Rendered from cv.json, not written in index.md. These three lines are
                  also the CV's key achievements, and when they lived in both places they
                  drifted — the home page and both PDFs named clients differently. One copy
                  is the whole point of the content model. */
                }
                <h2>Key Achievements</h2>
                <ul>
                  {
                    cv.achievements.map((item) => (
                      <li>
                        <strong>{item.title}</strong>: {item.detail}
                      </li>
                    ))
                  }
                </ul>
              </div>
              <div class='mt-6 flex gap-6'>
                {
                  social.map((item) => (
                    <a
                      class='group p-1 -m-1'
                      aria-label={'Follow on ' + item.data.title}
                      href={item.data.link}
                    >
                      <span
                        class:list={[
                          'h-6 w-6 text-secondary transition group-hover:text-accent',
                          item.data.icon
                        ]}
                      />
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class='[animation-delay:200ms] animate-fade-in-up'>
    <ImageCards />
  </div>

  <div class='mt-24 [animation-delay:400ms] animate-fade-in-up md:mt-28 sm:px-8'>
    <div class='mx-auto max-w-7xl lg:px-8'>
      <div class='px-4 relative lg:px-12 sm:px-8'>
        <div class='mx-auto max-w-2xl lg:max-w-5xl'>
          <div class='mx-auto gap-y-20 grid grid-cols-1 xl:grid-cols-2'>
            <div class='space-y-10 xl:pl-8'>
              <section aria-label='Call to action'>
                <CTAForm />
              </section>
              <section aria-label='Timeline'>
                <Timeline />
              </section>
              <section aria-label='Work history'>
                <Work />
              </section>
              <section aria-label='Education history'>
                <Education />
              </section>
            </div>
            <div class='space-y-10 xl:pl-8'>
              <section aria-label='Superpowers'>
                <Superpowers />
              </section>
              <section aria-label='Latest articles'>
                <ArticleList />
              </section>
            </div>
          </div>

          {
            /* Outside the grid, spanning both columns: this addresses a different reader
            from the career above it, and a card sitting in one column would read as one
            more item in that career rather than a change of subject. */
          }
          <section aria-label='Use this template' class='mt-20'>
            <TemplateCTA />
          </section>
        </div>
      </div>
    </div>
  </div>
</Layout>
