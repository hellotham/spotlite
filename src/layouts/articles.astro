---
import { getCollection } from 'astro:content'
import Layout from './layout.astro'
import Container from '../components/container.astro'
import PageContent from '../components/pagecontent.astro'
import WordCloud from '../components/wordcloud.astro'
import { ARTICLE_CATEGORIES, countTags } from '../utils/articles'

/**
 * The articles index: a grid of categories, then the tag cloud.
 *
 * It used to be one flat reverse-chronological list of everything. That stopped working
 * once the conference papers and the magazine writing occupied the same years — the SOA
 * talks of 2004 to 2006 interleaved line by line with the home theatre pieces, and
 * neither body of work could be read on its own. Categories are the fix; each gets its
 * own page, and the counts here are what make the grid worth scanning.
 *
 * Provenance categories lead, subject categories follow, because "where was this
 * published" is the coarser question and the one a CV site is asked first.
 */
const { frontmatter } = Astro.props

const articles = await getCollection('article')

const counts = new Map<string, number>()
for (const article of articles) {
  for (const category of new Set(article.data.categories)) {
    counts.set(category, (counts.get(category) ?? 0) + 1)
  }
}

// Keep the declared order rather than sorting by size: the grid's first row is meant to
// be the three provenance categories, and a count-ordered grid would shuffle them.
const cells = ARTICLE_CATEGORIES.map((category) => ({
  ...category,
  count: counts.get(category.name) ?? 0
})).filter((cell) => cell.count > 0)

const tags = countTags(articles)
const articleWord = (count: number) => (count === 1 ? 'article' : 'articles')
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  image={frontmatter.image}
  itemPage={true}
  collectionPage={true}
>
  <Container class='mt-16 sm:mt-32'>
    <div class='mx-auto max-w-2xl lg:max-w-5xl'>
      <PageContent {frontmatter}>
        <slot />
      </PageContent>

      <div class='mt-16 gap-4 grid sm:mt-20 lg:grid-cols-3 sm:grid-cols-2'>
        {
          cells.map((cell) => (
            <a
              href={`${import.meta.env.BASE_URL}articles/${cell.slug}/`}
              class='group p-6 ui-focus-ring border border-border rounded-2xl flex flex-col transition dark:border-border/40 hover:bg-heavenlyPink/50 dark:hover:bg-grapeade/30'
            >
              <h2 class='text-base text-accent tracking-tight font-semibold font-serif flex gap-2 items-baseline justify-between'>
                <span>{cell.name}</span>
                <span class='text-sm text-secondary font-normal font-sans tabular-nums'>
                  {cell.count}
                </span>
              </h2>
              <p class='text-sm text-secondary mt-2 flex-auto'>{cell.blurb}</p>
              <div
                aria-hidden='true'
                class='text-sm text-accent font-medium mt-4 flex items-center'
              >
                {cell.count} {articleWord(cell.count)}
                <span class='i-heroicons-chevron-right ml-1 h-4 w-4 transition stroke-current group-hover:translate-x-0.5' />
              </div>
            </a>
          ))
        }
      </div>

      <WordCloud
        tags={tags}
        unit='article'
        caption='Subjects across these articles, sized by the number of articles each one appears in.'
      />
    </div>
  </Container>
</Layout>
