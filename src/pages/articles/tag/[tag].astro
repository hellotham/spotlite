---
import { getCollection } from 'astro:content'
import Layout from '../../../layouts/layout.astro'
import Container from '../../../components/container.astro'
import ArticleIndex from '../../../components/articleindex.astro'
import { groupByTag } from '../../../utils/articles'

/**
 * One page per article tag, at /articles/tag/<slug>/.
 *
 * The nesting keeps tags out of the way of categories: /articles/<slug>/ is the category
 * route, and a tag landing there would collide the day someone tags an article "Software"
 * — which is already a category name. A tag is also the cross-cutting axis, so these
 * pages deliberately ignore category, and an article filed under two categories appears
 * here once.
 *
 * These exist because the word clouds point at them. A cloud whose labels lead nowhere is
 * a picture of a vocabulary; one whose labels are links is a way through the collection,
 * and the tags were only ever worth counting because the vocabulary is reused between
 * articles rather than reworded per article.
 */
export async function getStaticPaths() {
  const articles = await getCollection('article')

  return groupByTag(articles).map(({ tag, slug, entries }) => ({
    params: { tag: slug },
    props: {
      tag,
      articles: entries.sort((a, b) =>
        a.data.pubDate && b.data.pubDate ? +b.data.pubDate - +a.data.pubDate : 0
      )
    }
  }))
}

const { tag, articles } = Astro.props
const articleWord = articles.length === 1 ? 'article' : 'articles'
const description = `Everything here tagged ${tag} — ${articles.length} ${articleWord}, whenever they were written and wherever they were published.`
---

<Layout title={tag} description={description} itemPage={true} collectionPage={true}>
  <Container class='mt-16 sm:mt-32'>
    <div class='mx-auto max-w-2xl lg:max-w-5xl'>
      <header class='max-w-2xl'>
        <a
          href={`${import.meta.env.BASE_URL}articles/`}
          class='text-sm text-accent font-medium ui-focus-ring rounded-lg inline-flex items-center hover:underline'
        >
          <span class='i-heroicons-chevron-left mr-1 h-4 w-4 stroke-current' aria-hidden='true'
          ></span>
          All articles
        </a>
        <p class='text-sm text-secondary tracking-wide font-medium mt-4 uppercase'>Tagged</p>
        <h1 class='text-4xl text-primary tracking-tight font-bold font-serif mt-1 sm:text-5xl'>
          {tag}
        </h1>
        <!-- One expression, not two: adjacent expressions on separate lines render with no
             space between them, which reads as "51articles." -->
        <p class='text-base text-secondary mt-6'>
          {`${articles.length} ${articleWord}, newest first.`}
        </p>
      </header>

      <ArticleIndex {articles} />
    </div>
  </Container>
</Layout>
