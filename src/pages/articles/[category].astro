---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/layout.astro'
import Container from '../../components/container.astro'
import WordCloud from '../../components/wordcloud.astro'
import { ARTICLE_CATEGORIES, countTags } from '../../utils/articles'

/**
 * One page per article category.
 *
 * This sits at /articles/<slug>/, one level under the grid at /articles/. That nesting
 * beats the catch-all page route at src/pages/[...page].astro, which would otherwise
 * claim the same URL — Astro prefers the more specific file.
 *
 * Each page carries its own tag cloud, weighted over that category alone, because the
 * subjects inside "Conference papers" and inside "Audio and video" have almost nothing
 * in common and a site-wide cloud says nothing about either.
 */
export async function getStaticPaths() {
  const articles = await getCollection('article')
  return ARTICLE_CATEGORIES.map((category) => {
    const inCategory = articles
      .filter((article) => article.data.categories.includes(category.name))
      .sort((a, b) => (a.data.pubDate && b.data.pubDate ? +b.data.pubDate - +a.data.pubDate : 0))
    return { params: { category: category.slug }, props: { category, articles: inCategory } }
  }).filter((route) => route.props.articles.length > 0)
}

const { category, articles } = Astro.props
const tags = countTags(articles)
const articleWord = (count: number) => (count === 1 ? 'article' : 'articles')
---

<Layout title={category.name} description={category.blurb} itemPage={true} collectionPage={true}>
  <Container class='mt-16 sm:mt-32'>
    <div class='mx-auto max-w-2xl lg:max-w-5xl'>
      <header class='max-w-2xl'>
        <a
          href={`${import.meta.env.BASE_URL}articles/`}
          class='text-sm text-accent font-medium ui-focus-ring rounded-lg inline-flex items-center hover:underline'
        >
          <span class='i-heroicons-chevron-left mr-1 h-4 w-4 stroke-current' aria-hidden='true'
          ></span>
          All articles
        </a>
        <h1 class='text-4xl text-primary tracking-tight font-bold font-serif mt-4 sm:text-5xl'>
          {category.name}
        </h1>
        <p class='text-base text-secondary mt-6'>{category.blurb}</p>
        <!-- One expression, not two: adjacent expressions on separate lines render with no
             space between them, which read as "49articles." -->
        <p class='text-sm text-secondary mt-2'>
          {`${articles.length} ${articleWord(articles.length)}.`}
        </p>
      </header>

      <div class='mt-16 sm:mt-20'>
        <div class='md:pl-6 md:border-l md:border-barelyPink md:dark:border-grapeade/40'>
          <div class='flex flex-col space-y-16'>
            {
              articles.map((article) => (
                <article class='md:grid md:grid-cols-4 md:items-baseline'>
                  <div class='group flex flex-col items-start relative md:col-span-3'>
                    {article.data.pubDate && (
                      <time
                        class='text-sm text-graniteGray mb-3 pl-3.5 flex items-center order-first relative z-10 dark:text-opalGray md:hidden'
                        datetime={article.data.pubDate.toISOString()}
                      >
                        <span
                          class='flex items-center inset-y-0 left-0 absolute'
                          aria-hidden='true'
                        >
                          <span class='rounded-full bg-barelyPink h-4 w-0.5 dark:bg-morningGlory' />
                        </span>
                        {article.data.pubDate.toDateString()}
                      </time>
                    )}
                    <h2 class='text-base text-accent tracking-tight font-semibold font-serif'>
                      <div class='bg-heavenlyPink/50 opacity-0 scale-95 transition absolute z-0 sm:rounded-2xl dark:bg-grapeade/30 group-hover:opacity-100 group-hover:scale-100 -inset-x-4 -inset-y-6 sm:-inset-x-6' />
                      <a href={`${import.meta.env.BASE_URL}article/${article.id}/`}>
                        <span class='absolute z-20 sm:rounded-2xl -inset-x-4 -inset-y-6 sm:-inset-x-6' />
                        <span class='relative z-10'>{article.data.title}</span>
                      </a>
                    </h2>
                    <p class='text-sm text-graniteGray mt-2 relative z-10 dark:text-opalGray'>
                      {article.data.description}
                    </p>
                    <div
                      aria-hidden='true'
                      class='text-sm text-accent font-medium mt-4 flex items-center relative z-10'
                    >
                      Read article
                      <span class='i-heroicons-chevron-right ml-1 h-4 w-4 stroke-current' />
                    </div>
                  </div>
                  {article.data.pubDate && (
                    <time
                      class='text-sm text-graniteGray mb-3 mt-1 flex hidden items-center order-first relative z-10 dark:text-opalGray md:block'
                      datetime={article.data.pubDate.toISOString()}
                    >
                      {article.data.pubDate.toDateString()}
                    </time>
                  )}
                </article>
              ))
            }
          </div>
        </div>
      </div>

      <WordCloud
        tags={tags}
        unit='article'
        caption={`Subjects across the ${category.name.toLowerCase()}, sized by the number of articles each one appears in.`}
      />
    </div>
  </Container>
</Layout>
