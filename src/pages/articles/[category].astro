---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/layout.astro'
import Container from '../../components/container.astro'
import ArticleIndex from '../../components/articleindex.astro'
import WordCloud from '../../components/wordcloud.astro'
import { ARTICLE_CATEGORIES } from '../../utils/articles'
import { countLinkedTags } from '../../utils/tags'

/**
 * One page per article category.
 *
 * This sits at /articles/<slug>/, one level under the grid at /articles/. That nesting
 * beats the catch-all page route at src/pages/[...page].astro, which would otherwise
 * claim the same URL — Astro prefers the more specific file.
 *
 * Each page carries its own tag cloud, weighted over that category alone, because the
 * subjects inside "Conference papers" and inside "Audio and video" have almost nothing
 * in common and a site-wide cloud says nothing about either.
 */
export async function getStaticPaths() {
  const articles = await getCollection('article')
  return ARTICLE_CATEGORIES.map((category) => {
    const inCategory = articles
      .filter((article) => article.data.categories.includes(category.name))
      .sort((a, b) => (a.data.pubDate && b.data.pubDate ? +b.data.pubDate - +a.data.pubDate : 0))
    return { params: { category: category.slug }, props: { category, articles: inCategory } }
  }).filter((route) => route.props.articles.length > 0)
}

const { category, articles } = Astro.props
// Linked to the site-wide tag pages, not to a category-scoped view of the tag: a tag is
// the cross-cutting axis, and "Music" inside the DVD reviews is the same subject as
// "Music" inside the SA-CD ones.
const tags = countLinkedTags(articles)
const articleWord = (count: number) => (count === 1 ? 'article' : 'articles')
---

<Layout title={category.name} description={category.blurb} itemPage={true} collectionPage={true}>
  <Container class='mt-16 sm:mt-32'>
    <div class='mx-auto max-w-2xl lg:max-w-5xl'>
      <header class='max-w-2xl'>
        <a
          href={`${import.meta.env.BASE_URL}articles/`}
          class='text-sm text-accent font-medium ui-focus-ring rounded-lg inline-flex items-center hover:underline'
        >
          <span class='i-heroicons-chevron-left mr-1 h-4 w-4 stroke-current' aria-hidden='true'
          ></span>
          All articles
        </a>
        <h1 class='text-4xl text-primary tracking-tight font-bold font-serif mt-4 sm:text-5xl'>
          {category.name}
        </h1>
        <p class='text-base text-secondary mt-6'>{category.blurb}</p>
        <!-- One expression, not two: adjacent expressions on separate lines render with no
             space between them, which read as "49articles." -->
        <p class='text-sm text-secondary mt-2'>
          {`${articles.length} ${articleWord(articles.length)}.`}
        </p>
      </header>

      <ArticleIndex {articles} class='mt-16 sm:mt-20' />

      <WordCloud
        tags={tags}
        unit='article'
        caption={`Subjects across the ${category.name.toLowerCase()}, sized by the number of articles each one appears in. Each one leads to every article on that subject, in whatever category it was filed under.`}
      />
    </div>
  </Container>
</Layout>
