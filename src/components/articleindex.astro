---
import type { CollectionEntry } from 'astro:content'

/**
 * A dated list of articles, ruled down the left, for the pages that show a subset of the
 * collection: /articles/<category>/ and /articles/tag/<slug>/.
 *
 * Not to be confused with articlelist.astro, which is the home page's recent-writing
 * block — that one fetches the whole collection itself and renders a single column. This
 * one is handed its articles, because the whole point of both callers is that they have
 * already filtered.
 *
 * Extracted rather than copied: the two index pages are meant to be indistinguishable
 * apart from their headings, and a duplicated forty-line block is how that stops being
 * true a year later.
 */
interface Props {
  /** Already filtered and sorted by the caller — this renders them in the order given. */
  articles: CollectionEntry<'article'>[]
  /**
   * Spacing above the list, supplied by the caller: it sits directly under a page header
   * on a category page and under a section heading on a tag page, and those want different
   * gaps. Baking one in meant the tag page got both.
   */
  class?: string
  /**
   * Level for each article's own heading. A category page puts this list straight under
   * its `h1`, so the titles are `h2`; a tag page puts it under a "Writing" section
   * heading, which is itself an `h2`, so there they have to be `h3`. Hard-coding it gave
   * the tag page two `h2`s in a row, one nested inside the other's section.
   */
  headingLevel?: 2 | 3
}

const { articles, class: className, headingLevel = 2 } = Astro.props

const Heading = `h${headingLevel}` as 'h2' | 'h3'
---

<div class:list={[className]}>
  <div class='md:pl-6 md:border-l md:border-barelyPink md:dark:border-grapeade/40'>
    <div class='flex flex-col space-y-16'>
      {
        articles.map((article) => (
          <article class='md:grid md:grid-cols-4 md:items-baseline'>
            <div class='group flex flex-col items-start relative md:col-span-3'>
              {article.data.pubDate && (
                <time
                  class='text-sm text-graniteGray mb-3 pl-3.5 flex items-center order-first relative z-10 dark:text-opalGray md:hidden'
                  datetime={article.data.pubDate.toISOString()}
                >
                  <span class='flex items-center inset-y-0 left-0 absolute' aria-hidden='true'>
                    <span class='rounded-full bg-barelyPink h-4 w-0.5 dark:bg-morningGlory' />
                  </span>
                  {article.data.pubDate.toDateString()}
                </time>
              )}
              <Heading class='text-base text-accent tracking-tight font-semibold font-serif'>
                <div class='bg-heavenlyPink/50 opacity-0 scale-95 transition absolute z-0 sm:rounded-2xl dark:bg-grapeade/30 group-hover:opacity-100 group-hover:scale-100 -inset-x-4 -inset-y-6 sm:-inset-x-6' />
                <a href={`${import.meta.env.BASE_URL}article/${article.id}/`}>
                  <span class='absolute z-20 sm:rounded-2xl -inset-x-4 -inset-y-6 sm:-inset-x-6' />
                  <span class='relative z-10'>{article.data.title}</span>
                </a>
              </Heading>
              <p class='text-sm text-graniteGray mt-2 relative z-10 dark:text-opalGray'>
                {article.data.description}
              </p>
              <div
                aria-hidden='true'
                class='text-sm text-accent font-medium mt-4 flex items-center relative z-10'
              >
                Read article
                <span class='i-heroicons-chevron-right ml-1 h-4 w-4 stroke-current' />
              </div>
            </div>
            {article.data.pubDate && (
              <time
                class='text-sm text-graniteGray mb-3 mt-1 flex hidden items-center order-first relative z-10 dark:text-opalGray md:block'
                datetime={article.data.pubDate.toISOString()}
              >
                {article.data.pubDate.toDateString()}
              </time>
            )}
          </article>
        ))
      }
    </div>
  </div>
</div>
